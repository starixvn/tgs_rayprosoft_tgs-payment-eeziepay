<Project Sdk="Microsoft.NET.Sdk.Web">

	<PropertyGroup>
		<TargetFramework>net8.0</TargetFramework>
		<Nullable>enable</Nullable>
		<UserSecretsId>c4e5569d-ddb4-45c9-ab5b-1ecb7f50221f</UserSecretsId>
		<DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
		<GlobalNugetConfig>$(UserProfile)\AppData\Roaming\NuGet\NuGet.Config</GlobalNugetConfig>
		<GlobalNugetConfig Condition="'$(UserProfile)'==''">$(HOME)/.nuget/NuGet/NuGet.Config</GlobalNugetConfig>
		<DockerfileBuildArguments>--build-arg "BuildConfiguration=$(Configuration)" --secret id=nuget,src="$(GlobalNugetConfig)"</DockerfileBuildArguments>
		<DockerfileTag Condition="$(DockerfileTag) == ''">payment/eeziepay</DockerfileTag>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.AspNetCore.Mvc.Formatters.Xml" Version="2.2.0" />
		<PackageReference Include="AsyncMethodNameFixer" Version="2.3.0" />
		<PackageReference Include="FluentdForward.OpenTelemetry.MessagePack" Version="0.3.7" />
		<PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.7.0" />
		<PackageReference Include="OpenTelemetry.Extensions.Hosting" Version="1.7.0" />
		<PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.7.1" />
		<PackageReference Include="OpenTelemetry.Instrumentation.Http" Version="1.7.1" />
		<PackageReference Include="OpenTelemetry.Instrumentation.Runtime" Version="1.7.0" />
		<PackageReference Include="PhoenixToolkits.MessageQueue.Nats" Version="2.1.2" />
		<PackageReference Include="ProfileViewer.OpenTelemetry.Exporter" Version="0.3.1" />
		<PackageReference Include="Tgs.MessageQueue.Nats.Serializers" Version="0.0.2" />
		<PackageReference Include="Tgs.WebApi.Toolkits" Version="0.4.0" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\EeziePay.Core\EeziePay.Core.csproj" />
		<ProjectReference Include="..\EeziePay.Repositories\EeziePay.Repositories.csproj" />
	</ItemGroup>

</Project>
